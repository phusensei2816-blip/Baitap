rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi người dùng chỉ đọc/ghi dữ liệu của chính mình (hồ sơ + FCM token + việc)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
